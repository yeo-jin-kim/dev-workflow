{
  "schema_version": 1,
  "enabled": false,
  "authorization_reference": "REPLACE with owner-approved repair scope",
  "target": "/absolute/path/to/cora",
  "total_seconds": 3600,
  "graph": "/absolute/path/to/graph.db",
  "snapshot": "/absolute/path/to/snapshot.json",
  "content": "/absolute/path/to/content.db",
  "profile": "/absolute/path/to/trusted-recall-cases.json",
  "node_id": "REPLACE",
  "commands": {
    "audit": [
      "env",
      "PYTHONPATH=src",
      "python3",
      "-m",
      "cora.quality",
      "audit",
      "--graph-db",
      "{graph}",
      "--output",
      "{run}/audit.json"
    ],
    "trial": [
      "env",
      "PYTHONPATH=src",
      "python3",
      "-m",
      "cora.quality",
      "trial",
      "--graph-db",
      "{graph}",
      "--snapshot",
      "{snapshot}",
      "--content-db",
      "{content}",
      "--node-id",
      "{node}",
      "--output",
      "{run}/trial"
    ],
    "compare": [
      "env",
      "PYTHONPATH=src",
      "python3",
      "-m",
      "cora.quality",
      "compare",
      "--graph-db",
      "{graph}",
      "--snapshot",
      "{snapshot}",
      "--profile",
      "{profile}",
      "--output",
      "{run}/trial"
    ]
  }
}
