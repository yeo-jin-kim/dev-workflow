    "--evidence",
    "{evidence}",
    "--graph",
    "/ABSOLUTE/PATH/TO/graph.db",
    "--snapshot",
    "/ABSOLUTE/PATH/TO/snapshot.json",
    "--python",
    "/ABSOLUTE/PATH/TO/COra_PYTHON"
  ]
}
